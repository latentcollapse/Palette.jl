@@ -420,4 +422,119 @@ describe("NIRA-Prime: NeuraJL substrate modes (via createAgentSession)", () => {
 		// test-policy: allow explicit-test-timeout -- starts a real sandboxed Julia kernel; a cold precompile alone takes ~40s
