+	const answerHostRequest = (id: string, data: unknown) => {
+		void (async () => {
+			let reply: Record<string, unknown>;
+			try {
+				if (typeof data !== "object" || data === null || Array.isArray(data)) {
+					throw new Error("host request payload must be an object");
