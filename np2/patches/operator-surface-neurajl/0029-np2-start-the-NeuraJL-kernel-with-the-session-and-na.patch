 .../coding-agent/src/core/tools/neurajl.ts    | 29 ++++++++++--
 .../suite/neurajl-substrate-modes.test.ts     | 47 +++++++++++++++++--
 2 files changed, 67 insertions(+), 9 deletions(-)

