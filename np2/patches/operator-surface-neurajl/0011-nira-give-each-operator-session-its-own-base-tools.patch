+export type SessionBaseToolsFactory = (sessionId: string) => {
+	tools: Record<string, AgentTool>;
+	/** Release resources owned by this specific agent session. */
+	dispose?: () => void | Promise<void>;
+};
+
 export interface AgentSessionConfig {
